---
import Base from '../../layouts/Base.astro';
import { GUIAS } from '../../data/guias';
import { SITE_URL } from '../../site';

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', url: SITE_URL + '/guias/',
    name: 'Guías · IntegriAI', about: { '@id': `${SITE_URL}/#org` },
    hasPart: GUIAS.map(g => ({ '@type': 'Article', headline: g.t, url: `${SITE_URL}/guias/${g.slug}/` })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: SITE_URL + '/guias/' },
    ],
  },
];
---
<Base title="Guías para pymes: web, sistemas, automatización e IA | IntegriAI" description="Respuestas claras a las preguntas que más nos hacen: cuánto cuesta una página web, ERP vs CRM, automatización y agentes de IA para pymes." schema={schema}>
<section class="wrap lhero" aria-labelledby="t-h1">
  <nav class="crumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><span aria-current="page">Guías</span></nav>
  <div class="sec-head" style="max-width:900px">
    <span class="eyebrow">Guías</span>
    <h1 id="t-h1">Respuestas claras para <em>decidir mejor.</em></h1>
    <p class="def">Las preguntas que más nos hacen las pymes antes de invertir en una web, un sistema o una automatización, respondidas sin palabras de moda.</p>
  </div>
</section>

<section class="wrap" aria-label="Lista de guías" style="padding-bottom:clamp(48px, 7vw, 96px)">
  <div class="rel">
    {GUIAS.map(g => (
      <a class="relcard" href={`/guias/${g.slug}/`}>
        <small>{g.tema}</small><strong>{g.t}</strong>
        <span style="color:var(--mute);font-size:.9375rem">{g.d}</span>
        <span class="ic"><svg><use href="#i-arrow"/></svg></span>
      </a>
    ))}
    <a class="relcard acc" href="/diagnostico/">
      <small>Diagnóstico sin costo</small><strong>¿Tu pregunta no está aquí? Cuéntanos tu caso.</strong>
      <span class="ic"><svg><use href="#i-arrow"/></svg></span>
    </a>
  </div>
</section>
</Base>
