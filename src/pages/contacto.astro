---
import Base from '../layouts/Base.astro';
import { SITE_URL, WA_URL, WA_DISPLAY, EMAIL } from '../site';

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'ContactPage', url: SITE_URL + '/contacto/', name: 'Contacto · IntegriAI',
    mainEntity: {
      '@id': `${SITE_URL}/#org`,
      contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', email: EMAIL, telephone: WA_DISPLAY.replace(/\s/g, ''), areaServed: ['CL', 'Latinoamérica'], availableLanguage: ['es'] }],
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: 'Contacto', item: SITE_URL + '/contacto/' },
    ],
  },
];
---
<Base title="Contacto: WhatsApp, correo y diagnóstico | IntegriAI" description="Contacta a IntegriAI por WhatsApp, correo o pide un diagnóstico sin costo para tu empresa. Atendemos pymes en Chile y Latinoamérica." schema={schema}>
<section class="sec wrap diag" aria-labelledby="t-h1" style="padding-bottom:clamp(48px, 7vw, 96px)">
  <div class="diag-left">
    <nav class="crumbs" aria-label="Migas de pan" style="margin-bottom:0"><a href="/">Inicio</a><span>/</span><span aria-current="page">Contacto</span></nav>
    <span class="eyebrow">Contacto</span>
    <h1 class="h2" id="t-h1">Hablemos de <em>tu empresa.</em></h1>
    <p class="lead">Elige el canal que te acomode. Respondemos en menos de 2 días hábiles, normalmente el mismo día.</p>
    <ul class="ticks">
      <li>Atendemos pymes en Chile y Latinoamérica</li>
      <li>Reuniones online o visita en Santiago</li>
      <li>Diagnóstico sin costo y sin compromiso</li>
    </ul>
  </div>
  <div class="contact">
    <a class="row" href="/diagnostico/"><span class="ri"><svg><use href="#i-doc"/></svg></span><span><small>Recomendado</small><b>Solicitar diagnóstico sin costo</b></span></a>
    <a class="row" href={WA_URL} target="_blank" rel="noopener" data-ev="whatsapp"><span class="ri" style="color:#1FA855"><svg><use href="#i-wa"/></svg></span><span><small>WhatsApp</small><b>{WA_DISPLAY}</b></span></a>
    <a class="row" href={'mailto:' + EMAIL} data-ev="email"><span class="ri"><svg><use href="#i-mail"/></svg></span><span><small>Correo</small><b>{EMAIL}</b></span></a>
    <a class="row" href="/servicios/"><span class="ri"><svg><use href="#i-brief"/></svg></span><span><small>Antes de escribir</small><b>Ver nuestros servicios</b></span></a>
  </div>
</section>
</Base>
