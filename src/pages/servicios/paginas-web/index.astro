---
import Base from '../../../layouts/Base.astro';
import Precio from '../../../components/Precio.astro';
import Moneda from '../../../components/Moneda.astro';
import Web from '../../../components/mocks/Web.astro';
import { PLANES, MENSUAL, WEB_FAQ, fmtCLP } from '../../../data/web';
import { PROCESO } from '../../../data/servicios';
import { SITE_URL, WA_URL } from '../../../site';

const url = SITE_URL + '/servicios/paginas-web/';
const FILAS: [string, string[]][] = [
  ['Páginas', PLANES.map(p => p.paginas)],
  ['Diseño a medida y adaptado a celular', ['✓', '✓', '✓']],
  ['WhatsApp y formulario de contacto', ['✓', '✓', '✓']],
  ['SEO', ['Básico', 'Completo por página', 'Avanzado (productos y categorías)']],
  ['Google Analytics y Search Console', ['✓', '✓', '✓']],
  ['Textos ordenados para Google', ['—', '✓', '✓']],
  ['Google Business Profile (Maps)', ['—', '✓', '✓']],
  ['Formulario conectado a CRM o planilla', ['—', '✓', '✓']],
  ['Pagos en línea y catálogo', ['—', '—', '✓']],
  ['Funciones a medida e integraciones', ['—', '—', '✓']],
  ['Rondas de cambios', PLANES.map(p => p.cambios)],
  ['Plazo de entrega', PLANES.map(p => p.plazo)],
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', '@id': url + '#servicio',
    name: 'Diseño y desarrollo de páginas web', serviceType: 'Diseño de páginas web', url,
    description: 'Páginas web para empresas en tres niveles: landing page, web corporativa y tienda online o web avanzada.',
    provider: { '@id': `${SITE_URL}/#org` }, areaServed: [{ '@type': 'Country', name: 'Chile' }, { '@type': 'Place', name: 'Latinoamérica' }],
    offers: {
      '@type': 'AggregateOffer', priceCurrency: 'CLP', lowPrice: Math.min(...PLANES.map(p => p.clp)), highPrice: Math.max(...PLANES.map(p => p.clp)), offerCount: PLANES.length,
      offers: PLANES.map(p => ({ '@type': 'Offer', name: `${p.nivel}: ${p.nombre}`, url: `${url}${p.slug}/`, price: p.clp, priceCurrency: 'CLP', priceSpecification: { '@type': 'PriceSpecification', minPrice: p.clp, priceCurrency: 'CLP', valueAddedTaxIncluded: false } })),
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: SITE_URL + '/servicios/' },
      { '@type': 'ListItem', position: 3, name: 'Páginas web', item: url },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: WEB_FAQ.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Páginas web para pymes en Chile: precios | IntegriAI" description={`Diseño de páginas web en Chile: landing page desde ${fmtCLP(PLANES[0].clp)}, web corporativa desde ${fmtCLP(PLANES[1].clp)} y tienda online desde ${fmtCLP(PLANES[2].clp)} + IVA. Precios en USD para otros países.`} schema={schema}>
<section class="wrap lhero" aria-labelledby="t-h1">
  <nav class="crumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/servicios/">Servicios</a><span>/</span><span aria-current="page">Páginas web</span></nav>
  <div class="lhero-grid">
    <div class="lhero-copy">
      <span class="eyebrow">Páginas web · Planes y precios</span>
      <h1 id="t-h1">Páginas web para empresas, <em>con precio claro.</em></h1>
      <p class="def">Diseñamos y desarrollamos páginas web para empresas de Chile y Latinoamérica en tres niveles: una landing page para empezar, una web corporativa para aparecer en Google y una tienda online o web avanzada para vender y automatizar.</p>
      <div class="ctas">
        <a class="btn btn-dark" href="#planes">Ver planes <span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
        <a class="btn btn-light" href={WA_URL} target="_blank" rel="noopener" data-ev="whatsapp">Escribir por WhatsApp <span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
      </div>
    </div>
    <div class="lhero-mock"><Web /></div>
  </div>
</section>

<section class="sec wrap" id="planes" aria-labelledby="t-planes" style="padding-top:clamp(24px, 4vw, 48px)">
  <div class="planes-head">
    <div class="sec-head" style="margin-bottom:0">
      <span class="eyebrow">Planes</span>
      <h2 class="h2" id="t-planes">Elige el nivel <em>que necesitas.</em></h2>
    </div>
    <Moneda />
  </div>
  <div class="planes">
    {PLANES.map(p => (
      <article class:list={['plan', { dest: p.destacado }]}>
        {p.destacado && <span class="plan-flag">El más elegido</span>}
        <small class="plan-nivel">{p.nivel}</small>
        <h3>{p.nombre}</h3>
        <p class="plan-para">{p.para}</p>
        <div class="plan-precio"><span class="desde">Desde</span><Precio clp={p.clp} usd={p.usd} /></div>
        <ul class="ticks">{p.resumen.map(r => <li>{r}</li>)}</ul>
        <div class="plan-cta">
          <a class={p.destacado ? 'btn btn-acc' : 'btn btn-dark'} href={`/servicios/paginas-web/${p.slug}/`}>Ver plan {p.nivel.toLowerCase()} <span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
        </div>
      </article>
    ))}
  </div>
  <p class="plan-nota">Precios de referencia "desde", sin IVA en Chile. Cada proyecto parte con una propuesta por escrito con alcance, plazo y precio final.</p>
</section>

<section class="sec wrap" aria-labelledby="t-comp" style="padding-top:0">
  <div class="sec-head">
    <span class="eyebrow">Comparación</span>
    <h2 class="h2" id="t-comp">Qué incluye <em>cada plan.</em></h2>
  </div>
  <div class="tabla-wrap">
    <table class="tabla">
      <thead><tr><th scope="col">Incluye</th>{PLANES.map(p => <th scope="col"><small>{p.nivel}</small>{p.nombre}</th>)}</tr></thead>
      <tbody>
        <tr><th scope="row">Precio desde</th>{PLANES.map(p => <td><Precio clp={p.clp} usd={p.usd} /></td>)}</tr>
        {FILAS.map(([k, v]) => <tr><th scope="row">{k}</th>{v.map(x => <td class={x === '✓' ? 'si' : x === '—' ? 'no' : ''}>{x}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
</section>

<section class="sec wrap" aria-labelledby="t-mensual" style="padding-top:0">
  <div class="case">
    <div class="case-copy">
      <span class="eyebrow">Después de publicar</span>
      <h2 class="h2" id="t-mensual">{MENSUAL.nombre}: <em>tu web siempre al día.</em></h2>
      <p class="lead">Hosting, correos con tu dominio y soporte en un solo pago mensual. Es opcional: si ya tienes hosting, usamos el tuyo.</p>
      <div class="plan-precio"><span class="desde">Desde</span><Precio clp={MENSUAL.clp} usd={MENSUAL.usd} sufijo=" al mes" /></div>
      <p class="plan-nota" style="text-align:left;margin:0">{MENSUAL.nota}</p>
    </div>
    <ul class="ticks">{MENSUAL.incluye.map(i => <li>{i}</li>)}</ul>
  </div>
</section>

<section class="dark" aria-labelledby="t-proc">
  <div class="wrap sec">
    <span class="eyebrow">Cómo trabajamos</span>
    <h2 class="h2" id="t-proc" style="margin-top:18px">De la idea a tu web <em>publicada.</em></h2>
    <ol class="proc">
      {PROCESO.map((s, k) => <li><b>{String(k + 1).padStart(2, '0')}</b><strong>{s.t}</strong><span>{s.d}</span></li>)}
    </ol>
  </div>
</section>

<section class="sec wrap" aria-labelledby="t-faq">
  <div class="faq">
    <div class="faq-left">
      <span class="eyebrow">Preguntas frecuentes</span>
      <h2 class="h2" id="t-faq">Precios, plazos <em>y lo que incluye.</em></h2>
      <a class="btn btn-dark" href="/diagnostico/?servicio=web" style="align-self:flex-start">Cotizar mi web <span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
    </div>
    <div class="qs">
      {WEB_FAQ.map((f, k) => <details open={k === 0}><summary>{f.q}<i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}
    </div>
  </div>
</section>

<section class="wrap" aria-labelledby="t-rel" style="padding-bottom:clamp(48px, 7vw, 96px)">
  <h2 class="h3x" id="t-rel">¿Necesitas más que una web?</h2>
  <div class="rel">
    <a class="relcard" href="/servicios/digital/"><small>Software a medida</small><strong>Sistemas, ERP y CRM para tu empresa.</strong><span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
    <a class="relcard" href="/servicios/inteligencia-artificial/"><small>Inteligencia artificial</small><strong>Un agente que atiende tu web y tu WhatsApp.</strong><span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
    <a class="relcard acc" href="/diagnostico/?servicio=web"><small>Cotización sin costo</small><strong>Cuéntanos qué web necesitas.</strong><span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
  </div>
</section>
</Base>
