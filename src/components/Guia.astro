---
// Plantilla de las guías: migas, título, respuesta directa, cuerpo (slot), llamado a la acción, preguntas y guías relacionadas.
import Base from '../layouts/Base.astro';
import { GUIAS } from '../data/guias';
import { SITE_URL, WA_URL } from '../site';

interface Props {
  slug: string;
  title: string;          // <title>
  description: string;
  h1: string;
  respuesta: string;      // respuesta directa en 2 a 4 frases
  cta: { t: string; d: string; href: string; boton: string };
  faq: { q: string; a: string }[];
}
const { slug, title, description, h1, respuesta, cta, faq } = Astro.props;
const meta = GUIAS.find(g => g.slug === slug)!;
const url = `${SITE_URL}/guias/${slug}/`;
const otras = GUIAS.filter(g => g.slug !== slug).slice(0, 2);
const fechaTxt = new Date(meta.fecha + 'T12:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Article', '@id': url + '#guia',
    headline: h1, description, url, inLanguage: 'es-CL',
    datePublished: meta.fecha, dateModified: meta.fecha,
    author: { '@id': `${SITE_URL}/#org` }, publisher: { '@id': `${SITE_URL}/#org` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: SITE_URL + '/guias/' },
      { '@type': 'ListItem', position: 3, name: meta.t, item: url },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={description} schema={schema}>
<article class="sec wrap doc guia">
  <nav class="crumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/guias/">Guías</a><span>/</span><span aria-current="page">{meta.tema}</span></nav>
  <span class="eyebrow">Guía · {meta.tema}</span>
  <h1 class="h2">{h1}</h1>
  <p class="fecha">Publicada el <time datetime={meta.fecha}>{fechaTxt}</time> · IntegriAI</p>
  <div class="resp"><strong>Respuesta corta</strong><p set:html={respuesta} /></div>
  <div class="card">
    <slot />
  </div>

  <div class="card cta-guia">
    <h2>{cta.t}</h2>
    <p>{cta.d}</p>
    <div class="ctas">
      <a class="btn btn-dark" href={cta.href}>{cta.boton} <span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
      <a class="btn btn-light" href={WA_URL} target="_blank" rel="noopener" data-ev="whatsapp">Escribir por WhatsApp <span class="ic"><svg><use href="#i-arrow"/></svg></span></a>
    </div>
  </div>

  <h2 class="h3x" style="margin-top:48px">Preguntas frecuentes</h2>
  <div class="qs" style="margin-top:16px">
    {faq.map((f, k) => <details open={k === 0}><summary>{f.q}<i aria-hidden="true"></i></summary><p>{f.a}</p></details>)}
  </div>
</article>

{otras.length > 0 && (
<section class="wrap" aria-labelledby="t-rel" style="padding-bottom:clamp(48px, 7vw, 96px)">
  <h2 class="h3x" id="t-rel">Otras guías</h2>
  <div class="rel">
    {otras.map(o => (
      <a class="relcard" href={`/guias/${o.slug}/`}>
        <small>{o.tema}</small><strong>{o.t}</strong>
        <span class="ic"><svg><use href="#i-arrow"/></svg></span>
      </a>
    ))}
    <a class="relcard acc" href="/diagnostico/">
      <small>Diagnóstico sin costo</small><strong>Cuéntanos qué problema necesitas resolver.</strong>
      <span class="ic"><svg><use href="#i-arrow"/></svg></span>
    </a>
  </div>
</section>
)}
</Base>
